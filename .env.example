# Copy to `.env` for local dev (vercel dev), or set these in the Vercel
# project dashboard (Settings → Environment Variables) for production.
#
# Fill in real values locally or in Vercel — never commit them here.
# `.env` is git-ignored.

# ---- Notion (required by every /api/* function) ----
# Internal integration secret from https://www.notion.so/my-integrations
NOTION_TOKEN=

# Notion database IDs (working defaults already exist in the code; override to be safe)
MEMBERS_DB_ID=3e30d85f-784c-81e6-a79b-ca720cb76a5b
ATTENDANCE_DB_ID=3e30d85f-784c-8176-9c98-f98cad30a39f
CLUB_RECORDS_DB_ID=3e30d85f-784c-81e4-a908-f87400031506

# ---- Admin portal (/getsetgo) ----
# The admin login email is fixed in public/getsetgo/script.js
# (taupoathletics@gmail.com). The password is compared server-side by
# /api/auth against this value.
ADMIN_PASSCODE=

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
